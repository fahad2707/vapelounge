# Copy to `.env.local` for development or set in Vercel → Project → Settings → Environment Variables.

# MongoDB Atlas (recommended for Vercel — use Connect → Drivers in Atlas)
# Example: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Do NOT use a raw VPS IP (e.g. 159.x.x.x:27017) unless that server allows Vercel’s IPs.
MONGODB_URI=

# Optional — database name (default: vapelounge)
MONGODB_DB_NAME=vapelounge

# Set to 1 in Vercel only if you need index creation on production deploys (usually not required)
# MONGODB_ENSURE_INDEXES=1
